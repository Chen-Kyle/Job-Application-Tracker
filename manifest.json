{
  "manifest_version": 3,
  "name": "Job Application Tracker",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "description": "Save a job's company, role, link, and date from your current tab.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://sheets.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "oauth2": {
    "client_id": "32741109323-t9pp5emts58btvhoaq9pgmlug90125n1.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save a job"
  },
  "key": ""
}
